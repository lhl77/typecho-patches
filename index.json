          "after": "patches/2026-10-php85-pregmatch-null/1.3.0/after/var/Widget/Contents/EditTrait.php",
          "diff": "patches/2026-10-php85-pregmatch-null/1.3.0/change.diff",
          "expect": "/\\$name = \\(string\\) \\$item->input->getAttribute\\('name'\\);/"
